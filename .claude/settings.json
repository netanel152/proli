{
  "permissions": {
    "allow": [
      "mcp__railway__list_projects",
      "mcp__railway__list_services",
      "mcp__railway__list_deployments",
      "mcp__railway__list_domains",
      "mcp__railway__get_service_config",
      "mcp__railway__get_logs",
      "mcp__railway__environment_status",
      "mcp__railway__service_metrics",
      "mcp__linear__get_issue",
      "mcp__linear__list_issues",
      "mcp__linear__save_issue",
      "mcp__linear__save_comment",
      "mcp__linear__list_comments",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh run list:*)",
      "Bash(gh api:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git rev-list:*)",
      "Bash(git merge-base:*)",
      "mcp__mongodb__connect",
      "mcp__mongodb__list-databases",
      "mcp__mongodb__list-collections",
      "mcp__mongodb__collection-schema",
      "mcp__mongodb__collection-indexes",
      "mcp__mongodb__count",
      "mcp__mongodb__find",
      "mcp__mongodb__aggregate",
      "mcp__mongodb__explain",
      "mcp__mongodb__db-stats",
      "mcp__plugin_mongodb_mongodb__connect",
      "mcp__plugin_mongodb_mongodb__list-databases",
      "mcp__plugin_mongodb_mongodb__list-collections",
      "mcp__plugin_mongodb_mongodb__collection-schema",
      "mcp__plugin_mongodb_mongodb__collection-indexes",
      "mcp__plugin_mongodb_mongodb__count",
      "mcp__plugin_mongodb_mongodb__find",
      "mcp__plugin_mongodb_mongodb__aggregate",
      "mcp__plugin_mongodb_mongodb__explain",
      "mcp__plugin_mongodb_mongodb__db-stats",
      "mcp__claude_ai_Linear__get_issue",
      "mcp__claude_ai_Linear__list_issues",
      "Bash(railway status *)",
      "Bash(railway logs *)",
      "Bash(railway whoami)",
      "PowerShell(railway status *)",
      "PowerShell(railway logs *)",
      "PowerShell(railway whoami)",
      "Bash(venv/Scripts/python.exe -m pytest *)",
      "Bash(./venv/Scripts/python.exe -m pytest *)"
    ],
    "deny": [
      "Bash(railway variables set:*)",
      "PowerShell(railway variables set:*)",
      "mcp__railway__set_variables"
    ]
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start-context.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run-hook.sh\" pre-bash-guard.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run-hook.sh\" pre-edit-protect.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run-hook.sh\" post-edit-format.py",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "last30days@last30days-skill": true,
    "pyright-lsp@claude-plugins-official": true,
    "mongodb@claude-plugins-official": true
  }
}
